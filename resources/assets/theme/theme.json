                            "solid": {
                                "color": "#A66BB5"
                            }
                        },
                        "inputBoxColor": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        },
                        "searchTextSize": 10
                    }
                ],
                "filterCard": [
                    {
