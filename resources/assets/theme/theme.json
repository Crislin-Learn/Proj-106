        "callout": {
            "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
            "fontSize": 16,
            "color": "#481B5D"
        }
    },
    "visualStyles": {
        "page": {
            "*": {
                "background": [
                    {
                        "color": {
                            "solid": {
                                "color": "#F8F8FF"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "outspace": [
                    {
                        "color": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        }
                    }
                ],
                "pageSize": [
                    {
                        "pageSizeTypes": "Custom",
                        "pageSizeHeight": 720,
                        "pageSizeWidth": 1280
                    }
                ]
            }
        },
        "*": {
            "*": {
                "border": [
                    {
                        "color": {
                            "solid": {
                                "color": "#CECECE"
                            }
                        },
                        "show": true,
                        "radius": 10
                    }
                ],
                "visualHeader": [
                    {
                        "background": {
                            "solid": {
                                "color": "#722F8E"
                            }
                        },
                        "foreground": {
                            "solid": {
                                "color": "#FFFEFE"
                            }
                        },
                        "transparency": 20,
                        "border": {
                            "solid": {
                                "color": "#290440"
                            }
                        }
                    }
                ],
                "visualTooltip": [
                    {
                        "themedTitleFontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "themedValueFontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "themedBackground": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        },
                        "actionFontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "visualHeaderTooltip": [
                    {
                        "themedTitleFontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "themedBackground": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "outspacePane": [
                    {
                        "backgroundColor": {
                            "solid": {
                                "color": "#431568"
                            }
                        },
                        "foregroundColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "transparency": 0,
