    "background": "#F8F8FF",
    "foreground": "#481B5D",
    "tableAccent": "#744EC2",
    "good": "#009900",
    "neutral": "#FFC000",
    "bad": "#FF0000",
    "textClasses": {
        "title": {
            "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
            "fontSize": 16,
            "color": "#481B5D"
        },
        "header": {
            "fontFace": "Segoe UI",
            "fontSize": 18,
            "color": "#722F8E"
