                        },
                        "foregroundColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "borderColor": {
                            "solid": {
                                "color": "#722F8E"
                            }
                        },
                        "border": true,
                        "transparency": 0,
                        "fontFamily": "Segoe UI",
                        "textSize": 9,
                        "inputBoxColor": {
                            "solid": {
                                "color": "#722F8E"
                            }
                        }
                    },
                    {
                        "$id": "Applied",
                        "backgroundColor": {
                            "solid": {
                                "color": "#722F8E"
                            }
                        },
                        "foregroundColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "borderColor": {
                            "solid": {
                                "color": "#A66BB5"
                            }
                        },
                        "border": true,
                        "transparency": 0,
                        "fontFamily": "Segoe UI",
                        "textSize": 9,
                        "inputBoxColor": {
                            "solid": {
                                "color": "#722F8E"
                            }
                        }
                    }
                ],
                "padding": [
                    {
                        "left": 5,
                        "right": 5,
                        "bottom": 0,
                        "top": 10
                    }
                ]
            }
        },
        "cardVisual": {
            "*": {
                "title": [
                    {
                        "$id": "default",
                        "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
                        "fontColor": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        }
                    }
                ],
                "value": [
                    {
                        "$id": "default",
                        "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
                        "fontColor": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        }
                    }
                ]
            }
        },
        "slicer": {
            "*": {
                "border": [
                    {
                        "show": false
                    }
                ],
                "background": [
                    {
                        "color": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "items": [
                    {
                        "background": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "fontColor": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        },
                        "outline": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        },
                        "outlineWeight": 1
                    }
                ],
                "clear": [
                    {
                        "iconColor": {
                            "solid": {
                                "color": "#481B5D"
                            }
                        }
                    }
                ]
            }
        }
    }
}